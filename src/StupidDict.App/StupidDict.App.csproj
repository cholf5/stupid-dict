<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Multi-target: net10.0-windows unlocks System.Speech for the Windows
         TTS fallback; the other platforms build against plain net10.0. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <AssemblyName>StupidDict</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Single source for the About card, the update check and the release
         script: release.sh bumps this and tags vX.Y.Z, CI enforces equality. -->
    <Version>1.0.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- App icon embedded into the Windows exe (Explorer / taskbar); the same
         ico doubles as the window icon via avares:// below. -->
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
    <!-- MacDockIcon sends ObjC messages (unsafe pointers into libobjc). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Embedded via the avares:// protocol: Window Icon="avares://StupidDict/Assets/app-icon.ico",
       MacDockIcon loads the png the same way (prefix is the AssemblyName, not the project name).
       Explicit list on purpose: Assets/ also holds .cs sources, so no Assets/** wildcard.
       The icns is deliberately not embedded — it only travels via package.sh into the bundle. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/app-icon.png;Assets/app-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StupidDict.Core\StupidDict.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StupidDict.App.Tests" />
  </ItemGroup>

</Project>
