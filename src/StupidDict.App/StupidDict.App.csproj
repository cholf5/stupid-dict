<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Single TFM: the Windows TTS fallback drives SAPI through a PowerShell
         one-liner, so System.Speech — and with it the net10.0-windows TFM it
         needed — is gone. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>StupidDict</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Single source for the About card, the update check and the release
         script: release.sh bumps this and tags vX.Y.Z, CI enforces equality. -->
    <Version>1.2.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- NativeAOT readiness: the AOT/trim analyzers ride along in every
         normal build, so reflection the AOT compiler cannot handle turns red
         in dotnet test (TreatWarningsAsErrors), not only at publish time.
         TrimmerSingleWarn=false keeps each warning distinct instead of one
         aggregate. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- App icon embedded into the Windows exe (Explorer / taskbar); the same
         ico doubles as the window icon via avares:// below. -->
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
    <!-- MacDockIcon sends ObjC messages (unsafe pointers into libobjc). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Embedded via the avares:// protocol: Window Icon="avares://StupidDict/Assets/app-icon.ico",
       MacDockIcon loads the png the same way (prefix is the AssemblyName, not the project name).
       Explicit list on purpose: Assets/ also holds .cs sources, so no Assets/** wildcard.
       The icns is deliberately not embedded — it only travels via package.sh into the bundle. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/app-icon.png;Assets/app-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StupidDict.Core\StupidDict.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StupidDict.App.Tests" />
  </ItemGroup>

</Project>
