<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:history="using:StupidDict.Core.History"
        xmlns:loc="using:StupidDict.App.Localization"
        xmlns:sys="using:System"
        x:Class="StupidDict.App.MainWindow"
        Title="Stupid Dict"
        Width="780" Height="560"
        MinWidth="560" MinHeight="440"
        Background="{DynamicResource WindowBackground}">

  <Window.Styles>
    <Style Selector="TextBox#SearchBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Padding" Value="2,11" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextStrong}" />
    </Style>
    <Style Selector="TextBox#SearchBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Fluent paints a focused background and ring on the same part; on the
         dark theme that reads as a black slab inside the paper card. The caret
         is the focus indication for this borderless search box. -->
    <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <Border Grid.Row="0" Margin="18,18,18,6"
            CornerRadius="10" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
      <TextBox Name="SearchBox"
               Watermark="{Binding SearchWatermark, Source={x:Static loc:Translations.Instance}}">
        <TextBox.InnerLeftContent>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Spacing="1">
            <Button Name="NavBackButton" Classes="nav" Content="←" IsEnabled="False"
                    ToolTip.Tip="{Binding NavBackTip, Source={x:Static loc:Translations.Instance}}" Click="OnNavBackClick" />
            <Button Name="NavForwardButton" Classes="nav" Content="→" IsEnabled="False"
                    ToolTip.Tip="{Binding NavForwardTip, Source={x:Static loc:Translations.Instance}}" Click="OnNavForwardClick" />
            <TextBlock Text="🔍" Margin="10,0,4,0" VerticalAlignment="Center" FontSize="15" />
          </StackPanel>
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <Button Name="SettingsButton" Classes="nav" Content="⚙" Margin="0,0,8,0"
                  ToolTip.Tip="{Binding SettingsTip, Source={x:Static loc:Translations.Instance}}" Click="OnSettingsClick" />
        </TextBox.InnerRightContent>
      </TextBox>
    </Border>

    <Border Grid.Row="1" Name="SuggestPanel" IsVisible="False"
            Margin="18,6,18,0" CornerRadius="10" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6">
      <ScrollViewer MaxHeight="280">
        <ItemsControl Name="SuggestList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <Button Classes="suggest" Content="{Binding}" Click="OnSuggestClick" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <ScrollViewer Grid.Row="2" Padding="26,10,26,16">
      <Panel>
        <StackPanel Name="HintPanel"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="10" Margin="0,0,0,60">
          <TextBlock Text="Stupid Dict" FontSize="24" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextTitle}" HorizontalAlignment="Center" />
          <TextBlock Name="HintText" Text="{Binding SearchWatermark, Source={x:Static loc:Translations.Instance}}"
                     FontSize="14" HorizontalAlignment="Center" Classes="hint" />
          <TextBlock Text="{Binding Tagline, Source={x:Static loc:Translations.Instance}}" FontSize="12"
                     HorizontalAlignment="Center" Classes="hint" Opacity="0.8" />
        </StackPanel>

        <StackPanel Name="DictionaryDownloadPanel" IsVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="10" Margin="0,0,0,60">
          <TextBlock Text="Stupid Dict" FontSize="24" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextTitle}" HorizontalAlignment="Center" />
          <TextBlock Name="DictionaryDownloadStatus"
                     Text="{Binding DownloadPrompt, Source={x:Static loc:Translations.Instance}}"
                     FontSize="14" HorizontalAlignment="Center" Classes="hint"
                     TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
          <ProgressBar Name="DictionaryDownloadBar" Minimum="0" Maximum="100"
                       Height="4" MinWidth="280" IsVisible="False" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button Name="DownloadDictionaryButton" Classes="chip"
                    Content="{Binding StartDownload, Source={x:Static loc:Translations.Instance}}"
                    Click="OnDownloadDictionaryClick" />
            <Button Name="PickDictionaryButton" Classes="chip"
                    Content="{Binding PickLocalFile, Source={x:Static loc:Translations.Instance}}"
                    Click="OnPickDictionaryClick" />
            <Button Name="CancelDictionaryButton" Classes="chip"
                    Content="{Binding Cancel, Source={x:Static loc:Translations.Instance}}"
                    IsVisible="False" Click="OnCancelDictionaryClick" />
          </StackPanel>
        </StackPanel>

        <StackPanel Name="ResultsPanel" IsVisible="False" Spacing="4" />
      </Panel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Name="RecentPanel" Margin="20,6,20,16"
                Spacing="7" IsVisible="False">
      <TextBlock Text="{Binding Recent, Source={x:Static loc:Translations.Instance}}" Classes="label" Margin="4,0,0,0" />
      <ItemsControl Name="RecentList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="history:RecentSearch">
            <Button Classes="chip" Margin="0,0,8,8"
                    Content="{Binding Query}" Click="OnRecentClick" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Border Grid.Row="4" Name="AudioPackPanel" IsVisible="False"
            Background="{DynamicResource AudioBarBackground}" Padding="20,7">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Name="AudioPackStatus" VerticalAlignment="Center" FontSize="12"
                   Classes="hint" TextTrimming="CharacterEllipsis" />
        <ProgressBar Name="AudioPackBar" Width="140" Height="4" MinHeight="4"
                     VerticalAlignment="Center" Minimum="0" Maximum="100" />
        <Button Name="AudioPackActionButton" Classes="spk"
                Content="{Binding Cancel, Source={x:Static loc:Translations.Instance}}"
                Click="OnAudioPackActionClick" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
