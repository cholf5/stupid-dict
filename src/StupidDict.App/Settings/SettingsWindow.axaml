<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:StupidDict.App.Localization"
        x:Class="StupidDict.App.Settings.SettingsWindow"
        Title="{Binding SettingsTitle, Source={x:Static loc:Translations.Instance}}"
        Width="380" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <StackPanel Margin="20" Spacing="12">

    <TextBlock Text="{Binding SectionAppearance, Source={x:Static loc:Translations.Instance}}"
               Classes="label" Margin="4,0,0,0" />

    <Border CornerRadius="10" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14,10">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ThemeLabel, Source={x:Static loc:Translations.Instance}}"
                       FontSize="14" Foreground="{DynamicResource TextBody}" />
            <TextBlock Text="{Binding ThemeHint, Source={x:Static loc:Translations.Instance}}"
                       FontSize="12" Classes="hint" Margin="0,2,0,0" />
          </StackPanel>
          <!-- 选项顺序对应 AppTheme：0 跟随系统 / 1 日间 / 2 夜间 -->
          <ComboBox Name="ThemeComboBox" Grid.Column="1" MinWidth="110"
                    VerticalAlignment="Center" SelectedIndex="0">
            <ComboBoxItem Content="{Binding FollowSystem, Source={x:Static loc:Translations.Instance}}" />
            <ComboBoxItem Content="{Binding ThemeLight, Source={x:Static loc:Translations.Instance}}" />
            <ComboBoxItem Content="{Binding ThemeDark, Source={x:Static loc:Translations.Instance}}" />
          </ComboBox>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding LanguageLabel, Source={x:Static loc:Translations.Instance}}"
                       FontSize="14" Foreground="{DynamicResource TextBody}" />
            <TextBlock Text="{Binding LanguageHint, Source={x:Static loc:Translations.Instance}}"
                       FontSize="12" Classes="hint" Margin="0,2,0,0" />
          </StackPanel>
          <!-- 选项顺序对应 AppLanguage：0 跟随系统 / 1 简体中文 / 2 English -->
          <ComboBox Name="LanguageComboBox" Grid.Column="1" MinWidth="110"
                    VerticalAlignment="Center" SelectedIndex="0">
            <ComboBoxItem Content="{Binding FollowSystem, Source={x:Static loc:Translations.Instance}}" />
            <ComboBoxItem Content="{Binding LangChinese, Source={x:Static loc:Translations.Instance}}" />
            <ComboBoxItem Content="{Binding LangEnglish, Source={x:Static loc:Translations.Instance}}" />
          </ComboBox>
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding SectionAbout, Source={x:Static loc:Translations.Instance}}"
               Classes="label" Margin="4,8,0,0" />

    <Border CornerRadius="10" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14,10">
      <StackPanel Spacing="2">
        <TextBlock Text="Stupid Dict" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextTitle}" />
        <TextBlock Name="VersionText" FontSize="12" Classes="hint" />
        <TextBlock Text="{Binding AboutBlurb, Source={x:Static loc:Translations.Instance}}"
                   FontSize="12" Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Name="CheckUpdateButton" Classes="chip"
                  Content="{Binding CheckUpdate, Source={x:Static loc:Translations.Instance}}"
                  Click="OnCheckUpdateClick" />
          <Button Name="OpenReleaseButton" Classes="chip"
                  Content="{Binding OpenReleasePage, Source={x:Static loc:Translations.Instance}}"
                  IsVisible="False" Click="OnOpenReleaseClick" />
        </StackPanel>
        <TextBlock Name="UpdateStatusText" FontSize="12" Classes="hint"
                   TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

  </StackPanel>
</Window>
